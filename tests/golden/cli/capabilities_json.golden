{
  "commands": {
    "boot": {
      "output": "human_or_json",
      "side_effects": "opens_local_brain",
      "usage": "cortex boot [--agent <name>] [--budget <n>] [--json]"
    },
    "capture": {
      "output": "json_or_silent",
      "side_effects": "may_write_local_brain",
      "usage": "cortex capture <register|enable|disable|put|tail|get>"
    },
    "maintain": {
      "output": "json",
      "side_effects": "writes_local_brain",
      "usage": "cortex maintain [--jobs <n>]"
    },
    "mcp": {
      "output": "stdio_json_rpc",
      "side_effects": "may_write_local_brain",
      "usage": "cortex mcp [--agent <name>]"
    },
    "op": {
      "output": "json",
      "side_effects": "may_write_local_brain",
      "usage": "cortex op <operation> [--args <json>] [--agent <name>]"
    },
    "serve": {
      "purpose": "Optional bounded maintenance worker; no network listener",
      "side_effects": "writes_local_brain",
      "usage": "cortex serve"
    },
    "status": {
      "output": "human_or_json",
      "side_effects": "opens_existing_local_brain",
      "usage": "cortex status [--json]"
    }
  },
  "contract_version": "2",
  "environment": {
    "CORTEX_DB": "Local SQLite database",
    "CORTEX_HOME": "Local memory directory"
  },
  "exit_codes": {
    "0": "success",
    "1": "runtime_or_input_error",
    "2": "invalid_operation"
  },
  "operations": [
    "capabilities",
    "orient",
    "query",
    "expand",
    "commit",
    "checkpoint",
    "resolve",
    "feedback"
  ],
  "schema_version": 2,
  "tool": {
    "name": "cortex",
    "runtime": "asupersync",
    "transport": "local",
    "version": "0.6.0"
  }
}
